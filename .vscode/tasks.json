{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++-7 build active file",
            "command": "/usr/bin/g++-7",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            // "group": {
            //     "kind": "build"
            //     // "isDefault": true
            // },
            "detail": "Task generated by Debugger."
        },
        {
			"type": "shell",
			"label": "CMake config",
			"command": "cmake",
			"args": [
				"-DCMAKE_BUILD_TYPE=Debug",
				"-Dpybind11_DIR=~/.local/lib/python3.6/site-packages/pybind11/share/cmake/pybind11",
				".."
			],
			"options": {
				"cwd": "${workspaceFolder}/build", 
				"env": {
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
        {
			"type": "shell",
			"label": "CMake build",
			"command": "cmake",
			"args": [
				"--build",
				".",
				"--parallel",
				"4"
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
		{
			"type": "shell",
			"label": "CMake install",
			"command": "make",
			"args": [
                "DESTDIR=${STI_BASE_DIR}",
                "install"
			],
			"options": {
				"cwd": "${workspaceFolder}/build",
                "env": {
					"STI_BASE_DIR": "${workspaceFolder}"
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "Docs CMake config",
			"command": "cmake",
			"args": [
				".."
			],
			"options": {
				"cwd": "${workspaceFolder}/docs/build", 
				"env": {
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
		{
			"type": "shell",
			"label": "Docs CMake build",
			"command": "cmake",
			"args": [
				"--build",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}/docs/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
		{
			"type": "shell",
			"label": "CMake config (conda sti3-build)",
			"command": "conda",
			"args": [
				"run",
				"--no-capture-output",
				"-n", "sti3-build",
				"cmake",
				"-G", "Ninja",
				"-DCMAKE_BUILD_TYPE=Debug",
				"-DCMAKE_INSTALL_PREFIX:PATH=${STI_DEV_DIR}",
				"-DCMAKE_INSTALL_PYTHONDIR=Lib/site-packages",
				".."
				// add extra -D options here if you actually need them
			],
			"options": {
				"cwd": "${workspaceFolder}/build-ninja",
				"env": {
					"STI_DEV_DIR": "${workspaceFolder}/dev"
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "CMake build (conda sti3-build)",
			"command": "conda",
			"args": [
				"run",
				"--no-capture-output",
				"-n", "sti3-build",
				"cmake",
				"--build",
				".",
				// "--config", "Debug",
				"--parallel", "8"
			],
			"options": {
				"cwd": "${workspaceFolder}/build-ninja"
			},
			"group": {
				"kind": "build"
			},
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "CMake install (conda sti3-build)",
			"type": "shell",
			"command": "conda",
			"args": [
				"run", "--no-capture-output", "-n", "sti3-build",
				"cmake", "--install", "."
			],
			"options": {
				"cwd": "${workspaceFolder}/build-ninja"
			},
			"group": {
				"kind": "build"
			},
			"dependsOn": "CMake build (conda sti3-build)",
			"problemMatcher": []
		}
    ],
    "version": "2.0.0"
}