		{
			"type": "shell",
			"label": "Docs CMake config",
			"command": "cmake",
			"args": [
				".."
			],
			"options": {
				"cwd": "${workspaceFolder}/docs/build", 
				"env": {
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
		{
			"type": "shell",
			"label": "Docs CMake build",
			"command": "cmake",
			"args": [
				"--build",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}/docs/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
		{
			"type": "shell",
			"label": "CMake config (conda sti3-build)",
			"command": "conda",
			"args": [
				"run",
				"--no-capture-output",
				"-n", "sti3-build",
				"cmake",
				"-G", "Ninja",
				"-DCMAKE_BUILD_TYPE=RelWithDebInfo",
				"-DCMAKE_INSTALL_PREFIX:PATH=${STI_DEV_DIR}",
				"-DCMAKE_INSTALL_PYTHONDIR=Lib/site-packages",
				"-DCMAKE_EXE_LINKER_FLAGS=-Wl,--no-as-needed -L/home/hogan/miniconda3/envs/sti3-build/lib -Wl,-rpath,/home/hogan/miniconda3/envs/sti3-build/lib -lcurl",
				"-DCMAKE_SHARED_LINKER_FLAGS=-Wl,--no-as-needed -L/home/hogan/miniconda3/envs/sti3-build/lib -Wl,-rpath,/home/hogan/miniconda3/envs/sti3-build/lib -lcurl",
				".."
				// add extra -D options here if you actually need them
			],
			"options": {
				"cwd": "${workspaceFolder}/build-ninja",
				"env": {
					"STI_DEV_DIR": "${workspaceFolder}/dev"
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
