		{
			"type": "shell",
			"label": "Docs CMake config",
			"command": "cmake",
			"args": [
				".."
			],
			"options": {
				"cwd": "${workspaceFolder}/docs/build", 
				"env": {
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
		{
			"type": "shell",
			"label": "Docs CMake build",
			"command": "cmake",
			"args": [
				"--build",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}/docs/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
		{
			"type": "shell",
			"label": "CMake config (conda sti3-build)",
			"command": "conda",
			"args": [
				"run",
				"--no-capture-output",
				"-n", "sti3-build",
				"cmake",
				"--fresh",
				"-S", ".",
				"-B", "build",
				"-G", "Ninja",
				"-DCMAKE_BUILD_TYPE=Debug",
				"-DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDLL",
				"-DCMAKE_INSTALL_PREFIX:PATH=dev",
				"-DCMAKE_INSTALL_PYTHONDIR=build/Lib/site-packages",
				"-DCMAKE_EXE_LINKER_FLAGS=",
				"-DCMAKE_SHARED_LINKER_FLAGS="
				// Linux-only fallback linker flags are documented in AGENTS.md.
			],
			"linux": {
				"args": [
					"run",
					"--no-capture-output",
					"-n", "sti3-build",
					"bash", "-c",
					"cmake --fresh -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDLL -DCMAKE_INSTALL_PREFIX:PATH=dev -DCMAKE_INSTALL_PYTHONDIR=build/Lib/site-packages -DCMAKE_EXE_LINKER_FLAGS=\"-Wl,--no-as-needed -L$CONDA_PREFIX/lib -Wl,-rpath,$CONDA_PREFIX/lib -lcurl\" -DCMAKE_SHARED_LINKER_FLAGS=\"-Wl,--no-as-needed -L$CONDA_PREFIX/lib -Wl,-rpath,$CONDA_PREFIX/lib -lcurl\""
				]
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "CMake build (conda sti3-build)",
			"command": "conda",
			"args": [
				"run",
				"--no-capture-output",
				"-n", "sti3-build",
				"cmake",
				"--build",
				"build",
				// "--config", "Debug",
				"--parallel", "4"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build"
			},
			"problemMatcher": [
				"$gcc"
			]
		},
		// The development/debug workflow runs from build directly. Leave
		// install to the conda package build so this task does not recreate dev/.
		// {
		// 	"label": "CMake install (conda sti3-build)",
