		{
			"label": "test sti3",
			"type": "shell",
			"command": "ctest --test-dir build --output-on-failure",
			"dependsOn": ["CMake build (conda sti3-build)"],
			"problemMatcher": [],
			"group": {
				"kind": "build"
			}
		}
