    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Linux (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/profiles",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "CONDA_PREFIX", "value": "/home/hogan/miniconda3/envs/sti3" },
                {"name":"LD_LIBRARY_PATH","value":"/home/hogan/miniconda3/envs/sti3/lib:${env:LD_LIBRARY_PATH}"}
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing" },
                { "text": "-gdb-set print pretty on" },
                { "text": "-interpreter-exec console \"python import sys; sys.path.insert(0, '/home/hogan/miniconda3/envs/sti3/share/gcc-14.3.0/python')\"" },
                { "text": "-interpreter-exec console \"python from libstdcxx.v6.printers import register_libstdcxx_printers; register_libstdcxx_printers(None)\"" },
                { "text": "-gdb-set print object on" },
                { "text": "-interpreter-exec console \"set auto-load safe-path /\"" },
                { "text": "set substitute-path /usr/local/src/conda/stipy-3.0.1 /home/hogan/code/dev/sti3" },
                { "text": "-interpreter-exec console \"directory /home/hogan/code/dev/sti3/src/device/src\"" },
                { "text": "-interpreter-exec console \"directory /home/hogan/code/dev/sti3/src/network/src\"" }
            ],
            "preLaunchTask": "CMake build",
            "miDebuggerPath": "/home/hogan/miniconda3/envs/sti3/bin/gdb"
        },
        {
            "name": "g++ - Build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/readWrite",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake build",
            "miDebuggerPath": "/usr/bin/gdb"
            // "sourceFileMap": {
            //     "${workspaceFolder}/build": "${workspaceFolder}"
            // }
        }
        
    ]
}