{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell", //"cppbuild",
			"label": "C/C++: g++ build active file",
			"command": "/usr/bin/g++",
			"args": [
				"-g",
				"-std=c++11",
				"-std=c++14",
				"-pthread",
//				"-DSTI_BASE_DIR=${workspaceFolder}/../../../../",
				"-I${workspaceFolder}/../../../../include/",
				// "-I${STI_BASE_DIR}/include/",
				"-I${workspaceFolder}/../../../../src/device/src/",
				"-I${workspaceFolder}/../../../../src/network/src/",
				"TestDevice.cpp",
				"main.cpp",
				"-o",
				"${workspaceFolder}/testDevice",
//				"-L${STI_BASE_DIR}/lib",
				"-L${workspaceFolder}/../../../../lib/",
//				"-Wl,-rpath,.",
				"-lstinetwork",
				"-lstidevice",
				"-lpthread",
                "-lomnithread",
                "-lomniORB4",
                "-lomniDynamic4",
                "-lomniCodeSets4"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
			//"detail": "compiler: /usr/bin/g++"
		}
	]
}