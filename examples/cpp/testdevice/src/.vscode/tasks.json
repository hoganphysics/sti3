{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Configure (conda run)",
			"type": "shell",
			"command": "conda",
			"args": [
				"run", "-n", "sti3",
				"cmake",
				"-S", ".", "-B", "build",
				"-DCMAKE_BUILD_TYPE=Debug",
				"-DCMAKE_PREFIX_PATH=$CONDA_PREFIX",
				"-Dsti3_DIR=$CONDA_PREFIX/lib/cmake/sti3",
				"--debug-find"
			],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": ["$gcc"],
			"group": "build"
		},
		{
			"label": "Build (conda run)",
			"type": "shell",
			"command": "conda",
			"args": [
				"run", "-n", "sti3",
				"--no-capture-output",
				"cmake",
				"--build",
				"build",
				"-j"
			],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": ["$gcc"],
			"group": "build"
		},
		{
			"type": "shell", //"cppbuild",
			"label": "C/C++: g++ build active file",
			"command": "/usr/bin/g++",
			"args": [
				"-g",
				"-std=c++11",
				"-std=c++14",
				"-pthread",
//				"-DSTI_BASE_DIR=${workspaceFolder}/../../../../",
				"-I${workspaceFolder}/../../../../include/",
				// "-I${STI_BASE_DIR}/include/",
				"-I${workspaceFolder}/../../../../src/device/src/",
				"-I${workspaceFolder}/../../../../src/network/src/",
				"TestDevice.cpp",
				"main.cpp",
				"-o",
				"${workspaceFolder}/testDevice",
//				"-L${STI_BASE_DIR}/lib",
				"-L${workspaceFolder}/../../../../lib/",
				"-Wl,-rpath,.",
				"-lstinetwork",
				"-lstidevice",
				"-lpthread",
                "-lomnithread",
                "-lomniORB4",
                "-lomniDynamic4",
                "-lomniCodeSets4"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
			//"detail": "compiler: /usr/bin/g++"
		},
		{
			"type": "shell",
			"label": "CMake build",
			"command": "cmake",
			"args": [
				"--build",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "CMake configure",
			"command": "cmake",
			"args": [
				"-DCMAKE_BUILD_TYPE=Debug",
				".."
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
	]
}