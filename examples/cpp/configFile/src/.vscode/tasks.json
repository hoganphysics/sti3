{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Configure (conda run)",
			"type": "shell",
			"command": "conda",
			"args": [
				"run", "-n", "sti3",
				"cmake",
				"-S", ".", "-B", "build",
				"-DCMAKE_BUILD_TYPE=Debug",
				"-DCMAKE_PREFIX_PATH=$CONDA_PREFIX",
				"-Dsti3_DIR=$CONDA_PREFIX/lib/cmake/sti3",
				"--debug-find"
			],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": ["$gcc"],
			"group": "build"
		},
		{
			"label": "Build (conda run)",
			"type": "shell",
			"command": "conda",
			"args": [
				"run", "-n", "sti3",
				"--no-capture-output",
				"cmake",
				"--build",
				"build",
				"-j"
			],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": ["$gcc"],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "CMake build",
			"command": "cmake",
			"args": [
				"--build",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "CMake configure",
			"command": "cmake",
			"args": [
				".."
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
	]
}