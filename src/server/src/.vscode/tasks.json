{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "CMake config",
			"command": "cmake",
			"args": [
				".."
			],
			"options": {
				"cwd": "${workspaceFolder}/build", 
				"env": {
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
        {
			"type": "shell",
			"label": "CMake build",
			"command": "cmake",
			"args": [
				"--build",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
        {
			"type": "shell",
			"label": "CMake install",
			"command": "make",
			"args": [
                "DESTDIR=${STI_BASE_DIR}",
                "install"
			],
			"options": {
				"cwd": "${workspaceFolder}/build",
                "env": {
					"STI_BASE_DIR": "${workspaceFolder}/../../.."
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
	]
}