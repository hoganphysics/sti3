#ifndef STI_TNETWORK_ORBTYPES_IDL
#define STI_TNETWORK_ORBTYPES_IDL

module STI
{
module TNetwork
{

	struct TDeviceHubID
	{
		string name;
		string address;
		unsigned short moduleNum;
	};
	typedef sequence<TDeviceHubID> TDeviceHubIDSeq;

	struct TDeviceHubTrace
	{
		TDeviceHubIDSeq ids;
	};

	struct TDeviceID 
	{
		string         deviceName;
		string         address;
		unsigned short moduleNum;
		string         targetServer;
	};
	typedef sequence<TDeviceID> TDeviceIDSeq;

	struct TDeviceIDVertex
	{
		TDeviceID id;
		sequence<unsigned long> outConnections;
	};
	typedef sequence<TDeviceIDVertex> TDeviceIDVertexSeq;

	struct TEventEngineDependencyTree
	{
		TDeviceIDVertexSeq vertices;
	};

	struct TDeviceTrace
	{
		TDeviceIDSeq ids;
	};

	enum TEngineJobStatus { New, Running, Completed, Canceled };
	enum TRawEventType { RawEventPlay, RawEventMeasurement, RawEventWaveform, RawEventPause, RawEventJump };
	typedef sequence<unsigned long> TGraphPathLabel;

	typedef sequence<octet> OctetSeq;

	interface TFileHolder;

	union TMixedValue;
	// struct TMixedValue;
	typedef sequence<TMixedValue> TMixedValueSeq;
	enum TMixedValueType { MixedValueBoolean, MixedValueInt, MixedValueDouble, MixedValueString, MixedValueVector, MixedValueEmpty, MixedValueFile, MixedValueImage, MixedValueAny};
	
	union TMixedValue switch(TMixedValueType) {
		case MixedValueBoolean: boolean value_b;
		case MixedValueInt:		long    value_i;
		case MixedValueDouble: 	double  value_d;
		case MixedValueString:	string  value_s;
		case MixedValueVector: 	TMixedValueSeq values;
		case MixedValueEmpty: 	boolean empty;
		case MixedValueFile: 	TFileHolder	value_file;
		// case MixedValueImage:	TImage	value_image;
	};

	// struct TMixedValue
	// {
	// 	TMixedValueSeq values;

	// 	TMixedValueType type;

	// 	boolean value_b;
	// 	long    value_i;
	// 	double  value_d;
	// 	string  value_s;
	// };


	typedef sequence<string> TStringSeq;

	struct TAttribute
	{
		string key;
		string value;
		string group;
		TStringSeq allowedValues;
		TMixedValue metaData;
	};
	typedef sequence<TAttribute> TAttributeSeq;


	struct TRawEvent
	{
		double time;
		unsigned short channel;
		TMixedValue value;
		string description;
		//TEventStackTrace trace;
		boolean isMeasurement;
		TRawEventType rawEventType;
		TDeviceID targetDeviceID;

		TGraphPathLabel eventGraphPath;
	};
	typedef sequence<TRawEvent> TRawEventSeq;

	struct TDeviceEvents
	{
		TDeviceID targetDeviceID;
		TRawEventSeq events;
	};
	typedef sequence<TDeviceEvents> TDeviceEventsSeq;

	struct TMeasurement
	{
		TMixedValue measurementResult;
	
		double time;
		unsigned short channel;
		TGraphPathLabel measurementGraphPath;
		TDeviceID device;
	};
	typedef sequence<TMeasurement> TMeasurementSeq;



	struct TEngineID
	{
		long engineNumber;
	};

	enum TEngineState { EngineIdle, EngineParsing, EngineParsed, EnginePreparingPlay, EnginePlayReady, EngineWaitingForTrigger, EnginePlaying, EnginePaused, EngineUnknown, EngineMissing, EngineError };

	enum TEventEngineJobType { EngineJobParse, EngineJobPlay };
	
	struct TTimeStamp
	{
		long year;
		long month;
		long day;
		long hour;
		long min;
		long sec;
		long millis;
		long micros;
		long nanos;
	};

	struct TEngineJobSourceID
	{
		string user;
		string machine;
	};

	struct TParseID
	{
		TTimeStamp parseTimestamp;
		
		TEngineJobSourceID jobSourceID;

		string file;
		string comment;
	};

	struct TShotID
	{
		TParseID parseID;
		
		TTimeStamp submissionTime;
		TTimeStamp playTime;

		TEngineJobSourceID jobSourceID;
	};

	struct TEngineJobID
	{
    	TEventEngineJobType type;
    	TParseID pid;
    	TShotID sid;
	};

	interface TShot;

	struct TEventEngineJob
	{
		TEngineJobID jobID;
		TDeviceID jobOwner;
		TEngineJobStatus status;

		TEngineID engineID;
		//TEventEngine eventEngine;

		TShot shot;
		TEventEngineDependencyTree dependencies;
		TDeviceIDSeq missingTargetIDs;
	};

	interface TShotRepository;
	
	enum TTicketStatus { TicketRunning, TicketComplete, TicketCancelled, TicketNotFound };

	struct TResultTicket
	{
		TShotID sid;
		TTicketStatus status;
		
		// string url;
		// boolean hasURL;

		TShotRepository repo;
		boolean hasRepo;
	};

	//DeviceMessage *************************//

	enum TDeviceMessageType { MessageRefresh, MessageCollectionUpdate, MessageChannelUpdate, MessageChannelsRefresh, 
							MessageAttributeUpdate, MessageAttributesRefresh, MessageMonitorUpdate, MessageEngineScheduler,
							MessageEngineStatus, MessageEngineParser, MessageEngineJobUpdate, MessageUnknown };
	typedef sequence<TDeviceMessageType> TDeviceMessageTypeSeq;

	struct TAnyMessage
	{
		TDeviceMessageType type;
		any mess;
	};

	struct TDeviceMessage
	{
		TDeviceMessageType type;
		TDeviceTrace sourceTrace;
		//TDeviceID sourceID;
	};

	struct TRefreshDeviceMessage
	{
		TDeviceMessage base;	//base class data
	};

	enum TCollectionMessageType { CollectionMessageAdd, CollectionMessageRemove, CollectionMessageRefresh };

	struct TCollectionUpdateMessage
	{
		TDeviceMessage base;	//base class data
		TCollectionMessageType collectionUpdateType;
	};

	enum TParsingMessageType { ParsingError, ParsingWarning, ParsingInformation };

	struct TEngineParsingMessage
	{
		TParsingMessageType type;

		TDeviceID sourceID;
		short id_code;
		string name;
		string message;
		TRawEventSeq events;
	};
	typedef sequence<TEngineParsingMessage> TEngineParsingMessageSeq;


	enum TSchedulerMessageType { SchedulerParseComplete, SchedulerYieldParse, SchedulerPartialParse, SchedulerPlayReady, SchedulerPlayComplete, SchedulerYieldPlay };
	
	interface TEventEngine;

	struct TEngineSchedulerMessage
	{
		TDeviceMessage base;	//base class data

		TSchedulerMessageType type;
		TEngineJobID jobID;

		//TDeviceID originalSource;	//device that generated the original message
		TEventEngine engine;

		TRawEventSeq handledEvents;		//:device generated events that are being sent upstream for documentation, but they have already been parsed
		TRawEventSeq unhandledEvents;	//:device generated events that have not been parsed and are being sent upstream so their target can be found. 

		TEngineParsingMessageSeq messages;

		TEngineState engineState;
	};

	enum TEngineJobUpdateTarget {  JobUpdateTargetQueued, JobUpdateTargetRunning, JobUpdateTargetCompleted };

	struct TEngineJobUpdateDeviceMessage
	{
		TDeviceMessage base;	//base class data

		TEngineJobUpdateTarget targetList;
		TEventEngineJob engineJob;
	};

	struct TAttributeUpdateTuple
	{
		string key;
		string value;
	};
	typedef sequence<TAttributeUpdateTuple> TAttributeUpdateTupleSeq;

	struct TAttributeUpdateMessage
	{
		TDeviceMessage base;	//base class data

		TAttributeUpdateTupleSeq attributes;		//{key, value} pairs
	};

	enum TChannelUpdateMessageType { ChannelUpdataValue, ChannelUpdateName };

	struct TChannelUpdateTuple
	{
		short channelNumber;
		TMixedValue value;
	};
	typedef sequence<TChannelUpdateTuple> TChannelUpdateTupleSeq;

	struct TChannelUpdateMessage
	{
		TDeviceMessage base;	//base class data

		TChannelUpdateMessageType channelUpdateType;

		TChannelUpdateTupleSeq channelValues;	//{channel, value} pairs

		//only used for ChannelName messages
		short channelNumber;
		string channelName;
	};


	struct TEngineStateTuple
	{
		TEngineID engineID;
		TEngineState state;
	};
	typedef sequence<TEngineStateTuple> TEngineStateTupleSeq;

	struct TEngineStateMessage
	{
		TDeviceMessage base;	//base class data

		TEngineStateTupleSeq engineStates;	//{engineID, state} pairs
	};



	struct TEngineParserDeviceMessage
	{
		TDeviceMessage base;	//base class data
		TParseID pid;
		TEngineParsingMessageSeq messages;
	};

	//**********************************//


	enum TChannelType { TChannelOutput, TChannelInput };


	struct TChannel
	{
		short channelNumber;
		string channelName;

		TChannelType type;
		TMixedValueType inputType;
		TMixedValueType outputType;
		
		TMixedValue lastValue;

		TMixedValue metaData;
	};
	typedef sequence<TChannel> TChannelSeq;

	// struct TEngineSchedulerParseMessage
	// {
	// 	TDeviceEvent base;	//base class data

	// 	TEngineJobID jobID;
	// 	TSchedulerMessageType type;

	// 	TDeviceID originalSource;	//device that generated the original message

	// 	TRawEventSeq handledEvents;		//:device generated events that are being sent upstream for documentation, but they have already been parsed
	// 	TRawEventSeq unhandledEvents;	//:device generated events that have not been parsed and are being sent upstream so their target can be found. 
	// };

	// struct TEngineSchedulerTRawEventSeq
	// 	TEngineJobID jobID;
	// 	TSchedulerMessageType type;

	// 	TDeviceID originalSource;	//device that generated the original message

	// 	TEventEngine engine;
	// };

};	//TNetwork
};	//STI

#endif

