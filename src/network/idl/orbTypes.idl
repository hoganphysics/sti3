#ifndef STI_TNETWORK_ORBTYPES_IDL
#define STI_TNETWORK_ORBTYPES_IDL

module STI
{
module TNetwork
{

	struct TDeviceHubID
	{
		string name;
		string address;
		unsigned short moduleNum;
	};
	typedef sequence<TDeviceHubID> TDeviceHubIDSeq;

	struct TDeviceHubTrace
	{
		TDeviceHubIDSeq ids;
	};

	struct TDeviceID 
	{
		string         deviceName;
		string         address;
		unsigned short moduleNum;
		string         targetServer;
	};
	typedef sequence<TDeviceID> TDeviceIDSeq;

	struct TDeviceIDVertex
	{
		TDeviceID id;
		sequence<unsigned long> outConnections;
	};
	typedef sequence<TDeviceIDVertex> TDeviceIDVertexSeq;

	struct TEventEngineDependencyTree
	{
		TDeviceIDVertexSeq vertices;
	};

	struct TDeviceTrace
	{
		TDeviceIDSeq ids;
	};

	enum TEngineJobStatus { JobNew, JobRunning, JobCompleted, JobCanceled, JobNotFound, JobArchived };
	enum TRawEventType { RawEventPlay, RawEventMeasurement, RawEventWaveform, RawEventPause, RawEventJump };
	typedef sequence<unsigned long> TGraphPathLabel;

	typedef sequence<octet> OctetSeq;

	interface TFileHolder;
	typedef sequence<TFileHolder> TFileHolderSeq;

	union TMixedValue;
	typedef sequence<TMixedValue> TMixedValueSeq;
	enum TMixedValueType { MixedValueBoolean, MixedValueInt, MixedValueDouble, MixedValueString, MixedValueVector, MixedValueEmpty, MixedValueFile, MixedValueImage, MixedValueAny};
	
	union TMixedValue switch(TMixedValueType) {
		case MixedValueBoolean: boolean value_b;
		case MixedValueInt:		long    value_i;
		case MixedValueDouble: 	double  value_d;
		case MixedValueString:	string  value_s;
		case MixedValueVector: 	TMixedValueSeq values;
		case MixedValueEmpty: 	boolean empty;
		case MixedValueFile: 	TFileHolder	value_file;
		// case MixedValueImage:	TImage	value_image;
	};

	typedef sequence<string> TStringSeq;

	struct TAttribute
	{
		string key;
		string value;
		string group;
		TStringSeq allowedValues;
		TMixedValue metaData;
	};
	typedef sequence<TAttribute> TAttributeSeq;


	struct TStringPair
	{
		string key;
		string value;
	};
	typedef sequence<TStringPair> TStringPairSeq;

	struct TStackFrame
	{
		unsigned long file;
		unsigned long line;
		unsigned long func;
	};
	typedef sequence<TStackFrame> TStackFrameSeq;

	struct TRawEventTargetDevice 
	{
		boolean isAbstract;
		string name;
		TDeviceID targetDeviceID;
	};
	
	struct TRawEventTargetChannel 
	{
		boolean isAbstract;
		string _name;
		unsigned short channel;
	};

	struct TRawEventTarget 
	{
		TRawEventTargetDevice device;
    	TRawEventTargetChannel channel;
	};


	struct TParsedVar
	{
		string name;
		TMixedValue value;
		TStackFrameSeq trace;
	};
	typedef sequence<TParsedVar> TParsedVarSeq;


	struct TRawEvent
	{
		double time;
		TRawEventTarget target;
		// TMixedValue value;
		TParsedVar parsedValue;
		string description;
		TStackFrameSeq stackTrace;

		boolean isMeasurement;
		TRawEventType rawEventType;

		TGraphPathLabel eventGraphPath;
	};
	typedef sequence<TRawEvent> TRawEventSeq;


	struct TMeasurement
	{
		TMixedValue measurementResult;
	
		double time;
		unsigned short channel;
		TGraphPathLabel measurementGraphPath;
		string fullGroupName;
		TDeviceID device;
	};
	typedef sequence<TMeasurement> TMeasurementSeq;


	struct TEngineID
	{
		long engineNumber;
	};

	enum TEngineState { EngineIdle, EngineParsing, EngineParsed, EnginePreparingPlay, EnginePlayReady, EngineWaitingForTrigger, EnginePlaying, EnginePaused, EngineUnknown, EngineMissing, EngineError };

	enum TEventEngineJobType { EngineJobParse, EngineJobPlay };
	
	struct TTimeStamp
	{
		long year;
		long month;
		long day;
		long hour;
		long min;
		long sec;
		long millis;
		long micros;
		long nanos;
	};

	struct TEngineJobSourceID
	{
		string user;
		string machine;
	};

	enum TShotType { ShotTypeSingle, ShotTypeSequence, ShotTypeSingleUndocumented };


	struct TShotConfig
	{
		TShotType shotType;
		
		TEngineJobSourceID jobSourceID;

		long targetEnginePool;

		string file;
		string comment;
	};

	struct TParseID
	{
		TTimeStamp parseTimestamp;
		TShotConfig shotConfig;
	};

	struct TShotID
	{
		TParseID parseID;
		TEngineJobSourceID jobSourceID;

		TTimeStamp submissionTime;
	};

	struct TEngineJobID
	{
    	TEventEngineJobType type;
    	TParseID pid;
    	TShotID sid;
	};
	typedef sequence<TEngineJobID> TEngineJobIDSeq;


	struct TShot;

	interface TShotCallback;

	struct TStackTraceData
	{
		TFileHolderSeq timingFiles;
		TStringSeq functionNames;
	};

	struct TStackTraceResult
	{
		TParseID parseID;
		TStackTraceData stackTraceData;
	};

	struct TParsedTag
	{
		string name;
		TStackFrameSeq trace;
	};
	typedef sequence<TParsedTag> TParsedTagSeq;


	struct RefPointPair
	{
		string name;
		double time;
	};
	typedef sequence<RefPointPair> RefPointPairSeq;

	struct TRawEventGroup;
	typedef sequence<TRawEventGroup> TRawEventGroupSeq;

	struct TRawEventGroup
	{
		string name;
		string parentName;
	    double timeOffset;
		RefPointPairSeq referencePoints;

		TRawEventSeq events;
		TStackTraceData stackTraceData;

    // std::map<std::string, RawEventTarget> targets;   //replace abstract targets in event list
    // std::map<std::string, RawEventTargetDevice> targetDevices;   //replace abstract devices in event list

		TParsedVarSeq overwrittenVars;

		TParsedVarSeq parsedVars;
		TParsedTagSeq parsedTags; 

		TRawEventGroupSeq subgroups;

		TMixedValue metaData;
	};


	struct TShot
	{
		TShotConfig shotConfig;
		TShotCallback shotCallback;
	};

	enum TEventEngineJobList { EngineJobListQueued, EngineJobListRunning, EngineJobListCompleted, EngineJobListArchived };

	struct TEventEngineJob
	{
		TEngineJobID jobID;
		TDeviceID jobOwner;
		TEngineJobStatus status;

		TEngineID engineID;
		//TEventEngine eventEngine;

		TShot shot;
		TEventEngineDependencyTree dependencies;
		TDeviceIDSeq missingTargetIDs;
	};
	typedef sequence<TEventEngineJob> TEventEngineJobSeq;


	interface TPersistenceManager;
	

	//DeviceMessage *************************//

	enum TDeviceMessageType { MessageRefresh, MessageCollectionUpdate, MessageChannelUpdate, MessageChannelsRefresh, 
							MessageAttributeUpdate, MessageAttributesRefresh, MessageMonitorUpdate, MessageEngineScheduler,
							MessageEngineStatus, MessageEngineParser, MessageEngineJobUpdate, MessageUnknown };
	typedef sequence<TDeviceMessageType> TDeviceMessageTypeSeq;

	struct TAnyMessage
	{
		TDeviceMessageType type;
		any mess;
	};

	struct TDeviceMessage
	{
		TDeviceMessageType type;
		TDeviceTrace sourceTrace;
	};

	struct TRefreshDeviceMessage
	{
		TDeviceMessage base;	//base class data
	};

	enum TCollectionMessageType { CollectionMessageAdd, CollectionMessageRemove, CollectionMessageRefresh };

	struct TCollectionUpdateMessage
	{
		TDeviceMessage base;	//base class data
		TCollectionMessageType collectionUpdateType;
	};

	enum TParsingMessageType { ParsingError, ParsingWarning, ParsingInformation };

	struct TEngineParsingMessage
	{
		TParsingMessageType type;

		TDeviceID sourceID;
		short id_code;
		string name;
		string message;
		TRawEventSeq events;
	};
	typedef sequence<TEngineParsingMessage> TEngineParsingMessageSeq;


	enum TSchedulerMessageType { SchedulerParseComplete, SchedulerYieldParse, SchedulerPartialParse, SchedulerPlayReady, SchedulerPlayComplete, SchedulerYieldPlay };
	
	interface TEventEngine;

	struct TEngineSchedulerMessage
	{
		TDeviceMessage base;	//base class data

		TSchedulerMessageType type;
		TEngineJobID jobID;

		//TDeviceID originalSource;	//device that generated the original message
		TEventEngine engine;

		TRawEventGroup handledEvents;		//:device generated events that are being sent upstream for documentation, but they have already been parsed
		TRawEventGroup unhandledEvents;	//:device generated events that have not been parsed and are being sent upstream so their target can be found. 

		TRawEventGroup upstreamPartnerEvents;

		TEngineParsingMessageSeq messages;

		TEngineState engineState;
	};

	// enum TEngineJobUpdateTarget {  JobUpdateTargetQueued, JobUpdateTargetRunning, JobUpdateTargetCompleted };

	struct TEngineJobUpdateDeviceMessage
	{
		TDeviceMessage base;	//base class data

		TEventEngineJobList targetList;
		TEventEngineJob engineJob;
	};

	struct TAttributeTuple
	{
		string key;
		string value;
	};
	typedef sequence<TAttributeTuple> TAttributeTupleSeq;

	struct TAttributeUpdateMessage
	{
		TDeviceMessage base;	//base class data
		TAttributeTupleSeq attributes;		//{key, value} pairs
	};

	enum TChannelUpdateMessageType { ChannelUpdataValue, ChannelUpdateName };

	struct TChannelUpdateTuple
	{
		short channelNumber;
		TMixedValue value;
	};
	typedef sequence<TChannelUpdateTuple> TChannelUpdateTupleSeq;

	struct TChannelUpdateMessage
	{
		TDeviceMessage base;	//base class data

		TChannelUpdateMessageType channelUpdateType;

		TChannelUpdateTupleSeq channelValues;	//{channel, value} pairs

		//only used for ChannelName messages
		short channelNumber;
		string channelName;
	};


	struct TEngineStateTuple
	{
		TEngineID engineID;
		TEngineState state;
	};
	typedef sequence<TEngineStateTuple> TEngineStateTupleSeq;

	struct TEngineStateMessage
	{
		TDeviceMessage base;	//base class data
		TEngineStateTupleSeq engineStates;	//{engineID, state} pairs
	};


	struct TEngineParserDeviceMessage
	{
		TDeviceMessage base;	//base class data
		TParseID pid;
		TEngineParsingMessageSeq messages;
	};

	//**********************************//


	enum TChannelType { TChannelOutput, TChannelInput };

	struct TChannel
	{
		short channelNumber;
		string channelName;

		TChannelType type;
		TMixedValueType inputType;
		TMixedValueType outputType;
		
		TMixedValue lastValue;

		TMixedValue metaData;
	};
	typedef sequence<TChannel> TChannelSeq;


	enum TRecordStatus { TRecordUnqueried, TRecordComplete, TRecordMissingDevice, TRecordMissingResults, TRecordError };

	struct TShotResultRecord;
	typedef sequence<TShotResultRecord> TShotResultRecordSeq;

	struct TShotResultRecord
	{
		TDeviceID deviceID;
		TRecordStatus recordStatus;
		TShotResultRecordSeq dependencies;
	};

	struct TDeviceIDAttributesTuple
	{
		TDeviceID id;
		TAttributeTupleSeq attributes;
	};

	typedef sequence<TDeviceIDAttributesTuple> TDeviceIDAttributesTupleSeq;

	struct TShotID;


	struct TParseResult
	{
		TParseID parseID;

		TRawEventGroup baseEventGroup;
		TEventEngineDependencyTree parsedDevices;
		TEngineParsingMessageSeq messages;
		TStackTraceResult stackTraceResult;
	};


	struct TShotResult
	{
		TShotID sid;
		TTimeStamp playTime;

		TMeasurementSeq measurements;
		TDeviceIDAttributesTupleSeq attributes;

		TShotResultRecord shotResultRecord;
	};

	struct TFullShotResult
	{
		TParseResult parseResult;
		TShotResult shotResult;
	};


};	//TNetwork
};	//STI

#endif

