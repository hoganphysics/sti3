    {
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "-std=c++11",
                "-std=c++1y",
                "-I${workspaceFolder}/../../../include/",
                "-I${workspaceFolder}/../../device/src/",
                "-I${workspaceFolder}",
                //"-I/usr/include/",
                //"${file}",
                "${fileDirname}/**.cpp",
                "-shared",
                "-fPIC",
				"-lpthread",
                "-lomnithread",
                "-lomniORB4",
                "-lomniDynamic4",
                "-lomniCodeSets4",
				"-lpthread",
                //"-lomnisslTP4",   //if OpenSSL is available
                "-lCOS4",
                "-lCOSDynamic4",
                "-o",
                //"${fileDirname}/${fileBasenameNoExtension}"
                "${fileDirname}/libstinetwork.so"

            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}