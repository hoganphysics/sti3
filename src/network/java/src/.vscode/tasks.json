{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "SWIG: build wrappers using swig",
            "command": "swig",
            "args": [
                "-c++",
                "-cppext",
                "cpp",
                "-java",
                "-package", "edu.stanford.sti",
                //"-debug-typedef",
                //"-debug-classes",
                "-I${workspaceFolder}/../../../device/src/",
                "-I${workspaceFolder}/../../../../include/",
                "-outdir",
                "../stilib/src/main/java/edu/stanford/sti/",
                "sti.i"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
			"type": "shell",
			"label": "C/C++: g++ build active file",
			"command": "/usr/bin/g++",
			"args": [
				"-g",
				"-std=c++11",
				"-std=c++1y",
				"-I/usr/lib/jvm/java-11-openjdk-amd64/include/",
				"-I/usr/lib/jvm/java-11-openjdk-amd64/include/linux/",
                "-I/usr/local/include/",
                "-I${STI_BASE_DIR}/include/",
                "-I${STI_BASE_DIR}/src/device/src/",
                "-I${STI_BASE_DIR}/src/network/src/",
				"${workspaceFolder}/**.cpp",
				//"${fileDirname}/**.cxx",
				"-shared",
                "-fPIC",
                // "-L${workspaceFolder}/../../../device/src/",
                // "-L${workspaceFolder}/../../src/",
                "-L${STI_BASE_DIR}/lib",
                "-lstidevice",
                "-lstinetwork",
				"-Wl,-rpath,.",
				"-o",
                //"${workspaceFolder}/../stilib/lib/libstijava.so"
                "${STI_BASE_DIR}/lib/libstijava.so"
			],
			"options": {
                "cwd": "${workspaceFolder}",
                "env": {
					"STI_BASE_DIR": "../../../.."
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
        {
			"type": "shell",
			"label": "CMake build",
			"command": "cmake",
			"args": [
				"--build",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
        {
			"type": "shell",
			"label": "CMake install",
			"command": "make",
			"args": [
                "DESTDIR=${STI_BASE_DIR}",
                "install"
			],
			"options": {
				"cwd": "${workspaceFolder}/build",
                "env": {
					"STI_BASE_DIR": "${workspaceFolder}/../../../.."
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
    ]
}