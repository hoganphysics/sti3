    {
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "-std=c++11",
                "-std=c++14",
                "-I${workspaceFolder}/../../../include/",
                "-I${workspaceFolder}/",
                "-I/usr/include/",
                //"${file}",
                "${workspaceFolder}/**.cpp",
                "-shared",
                "-fPIC",
                "-o",
                //"${fileDirname}/${fileBasenameNoExtension}"
                "${fileDirname}/libstidevice.so"

            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
					"STI_BASE_DIR": "../../.."
				}
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            }
        },
        {
			"type": "shell",
			"label": "CMake config",
			"command": "cmake",
			"args": [
				"-DCMAKE_BUILD_TYPE=Debug",
				".."
			],
			"options": {
				"cwd": "${workspaceFolder}/build", 
				"env": {
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
        {
			"type": "shell",
			"label": "CMake build",
			"command": "cmake",
			"args": [
				"--build",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
        },
        {
			"type": "shell",
			"label": "CMake install",
			"command": "make",
			"args": [
                "DESTDIR=${STI_BASE_DIR}",
                "install"
			],
			"options": {
				"cwd": "${workspaceFolder}/build",
                "env": {
					"STI_BASE_DIR": "${workspaceFolder}/../../.."
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
    ],
    "version": "2.0.0"
}