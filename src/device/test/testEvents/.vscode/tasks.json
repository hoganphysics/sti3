{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++ build active file",
			"command": "/usr/bin/g++",
			"args": [
				"-g",
				"-std=c++11",
				"-std=c++14",
				"-fPIC",
				"-pthread",
				"-I${STI_BASE}/include",
				"-I${STI_BASE}/src/device/src",
				"-I${STI_BASE}/src/network/src",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}",
				"-L${STI_BASE}/lib",
				"-lstidevice"
			],
			"options": {
				"cwd": "${workspaceFolder}", 
				"env": {
					"STI_BASE": "../../../.."
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "compiler: /usr/bin/g++"
		}
	]
}